# ── Firebase Configuration ───────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_FIRESTORE_DATABASE_ID=asquare-app-db

# ── Payment Gateway (Razorpay) ──────────────────────────────────────
# VITE_ prefix = exposed to client bundle (public key only)
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
# Server-only keys (NOT prefixed with VITE_)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Google Maps ─────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key

# ── Pipeline / Website API ──────────────────────────────────────────
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=/pipeline/api/v1
VITE_WEBSITE_API_URL=https://your-domain.com/Api/api.php
WEBSITE_API_KEY=your_api_key
WEBSITE_API_PASSWORD=your_api_password
VITE_WEBSITE_API_BRANCH_ID=1
VITE_WEBSITE_RECENT_LOGINS_TRANSAC=get_recent_logins_count

# ── Superfone (Call Tracking) ───────────────────────────────────────
VITE_SUPERFONE_WEBHOOK_URL=/pipeline/superfone-webhook.php
VITE_SUPERFONE_WEBHOOK_TOKEN=your_webhook_token
VITE_SUPERFONE_WEBHOOK_MODE=events
VITE_SUPERFONE_WEBHOOK_LIMIT=200

# ── Firestore Feature Flags ────────────────────────────────────────
VITE_USE_FIRESTORE_LEADS=true
VITE_USE_FIRESTORE_USERS=true
VITE_USE_FIRESTORE_TASKS=true
VITE_USE_FIRESTORE_CONTACTS=true
VITE_USE_FIRESTORE_TODOS=true

# ── Interakt (WhatsApp Notifications) ──────────────────────────────
INTERAKT_API_KEY=your_interakt_api_key_base64
VITE_INTERAKT_PAYMENT_REQUEST_HEADER_IMAGE_URL=/asquare-payment-header.png
VITE_INTERAKT_LEADS_URL=https://your-domain.com/Api/api.php
VITE_INTERAKT_LEADS_KEY=your_interakt_leads_key

# ── Optional: Firebase Emulators ───────────────────────────────────
VITE_USE_EMULATORS=false
