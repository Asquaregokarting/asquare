{
  "name": "asquare_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "audit:duplicates": "tsx scripts/audit-user-duplicates.ts",
    "dedup:users": "tsx scripts/dedup-users.ts",
    "assets:generate": "capacitor-assets generate --iconBackgroundColor #0066FF --iconBackgroundColorDark #001b3a --splashBackgroundColor #0a0e1a --splashBackgroundColorDark #0a0e1a",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/preferences": "^8.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@specy/liquid-glass": "^1.12.1",
    "@specy/liquid-glass-react": "^1.0.2",
    "@tanstack/react-query": "^5.17.0",
    "clsx": "^2.1.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.10.0",
    "firebase-functions": "^7.2.2",
    "framer-motion": "^10.18.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.303.0",
    "motion": "^12.38.0",
    "ogl": "^1.0.11",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-confetti": "^6.4.0",
    "react-day-picker": "^9.13.1",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.21.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^2.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.7.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "jsdom": "^23.2.0",
    "jsrepo": "^3.7.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "puppeteer": "^24.40.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "shadcn": "^4.1.2",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
